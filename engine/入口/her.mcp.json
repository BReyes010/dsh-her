{
  "_说明": "把 python 换成你机器上的 Python 绝对路径；把 args 里的路径换成 her-host.py 的实际路径。",
  "_用途": "任何支持 MCP 的客户端（Claude Desktop / Cursor / DSH / 其他）都可直接加这一段。",
  "mcpServers": {
    "dafeiyu": {
      "command": "C:\\Users\\{USER}\\.dsh\\dsh-runtimes\\dsh-next-primary-runtime\\dependencies\\python\\python.exe",
      "args": [
        "{ENGINE_ROOT}\\入口\\her-host.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    }
  }
}
